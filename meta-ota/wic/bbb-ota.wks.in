bootloader --ptable gpt

part --source rawcopy --ondisk mmcblk0 --no-table --align 128  --sourceparams="file=MLO"
part --source rawcopy --ondisk mmcblk0 --no-table --align 384  --sourceparams="file=u-boot.img"
part --source rawcopy --ondisk mmcblk0 --no-table --align 2432 --sourceparams="file=u-boot-env.raw"

part       --source rawcopy --ondisk mmcblk0 --fstype=vfat --label bootA --align 4096 --fixed-size 24  --active --sourceparams="file=boot-home-gateway.vfat"
part       --source rawcopy --ondisk mmcblk0 --fstype=ext4               --align 4096 --fixed-size 160 --sourceparams="file=${ROOTFS_ARTIFACT}"
part       --source empty   --ondisk mmcblk0 --fstype=vfat --label bootB --align 4096 --fixed-size 24
part       --source empty   --ondisk mmcblk0 --fstype=ext4 --label rootB --align 4096 --fixed-size 160
part /data --source rawcopy --ondisk mmcblk0 --fstype=ext4 --label data  --align 4096 --fixed-size 128 --sourceparams="file=data-home-gateway.ext4"
